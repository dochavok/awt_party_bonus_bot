# Store text files with LF line endings in the repository and working copy,
# so files match on Windows and on the Linux host the bot runs on.
* text=auto eol=lf

# Windows scripts need CRLF.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary files: never convert.
*.png binary
*.jpg binary
*.pdf binary
*.db  binary
